rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Sandbox Access
    // In a production app, the backend would use the Firebase Admin SDK.
    // Here, since we sync from a Node backend acting as a client, we grant open access.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}